+
+package app.morphe.extension.music.patches.lyrics.session;
+
+import android.media.MediaMetadata;
+import android.media.session.MediaSession;
+import android.os.Handler;
+import android.os.Looper;
+import android.net.Uri;
+
+import androidx.annotation.Nullable;
+
+import org.json.JSONObject;
+
+import java.lang.ref.WeakReference;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.Objects;
+
+import app.morphe.extension.music.patches.lyrics.LyricsManager;
+import app.morphe.extension.music.patches.lyrics.model.Lyrics;
+import app.morphe.extension.music.patches.lyrics.model.LyricsLine;
+import app.morphe.extension.music.patches.lyrics.model.MetadataCleaner;
+import app.morphe.extension.music.patches.lyrics.model.TrackInfo;
+import app.morphe.extension.music.settings.Settings;
+import app.morphe.extension.shared.Logger;
+
+/**
+ * Publishes the loaded, time-synced lyrics in the {@code "lyricInfo"} MediaMetadata entry that
+ * ColorOS / OPlus SystemUI reads for its native lock-screen and always-on-display lyric page.
+ *
+ * <p>Unlike {@link LockScreenLyrics}, the track title and artist are never rewritten, only one
+ * extra metadata key is added to a copy of the app's own metadata. The two features are
+ * mutually exclusive, {@link LockScreenLyrics} stands down while this one is on.
+ *
+ * <p>Hooked in front of the app's {@code MediaSession.setMetadata} call. The app's call runs
+ * right after the hook and would replace anything pushed synchronously, so the metadata with
+ * the lyrics is pushed from a short delayed task, directly through the framework so the hooked
+ * call site is not re-entered.
+ */
+@SuppressWarnings("unused")
+public final class LyricInfoPublisher {
+
+    private static final String LYRIC_INFO_KEY = "lyricInfo";
+    private static final String PROVIDER = "app.morphe.music";
+    /** The system reads at most about 512 KiB; stay well below it. */
+    private static final int MAX_LRC_CHARS = 200_000;
+    private static final long PUBLISH_DELAY_MS = 60;
+
+    private static final Handler handler = new Handler(Looper.getMainLooper());
+    private static final Runnable publishTask = LyricInfoPublisher::publish;
+
+    @Nullable
+    private static volatile WeakReference<MediaSession> sessionRef;
+    @Nullable
+    private static volatile MediaMetadata originalMetadata;
+    @Nullable
+    private static volatile Lyrics latestLyrics;
+    @Nullable
+    private static volatile String cleanedTitle;
+    @Nullable
+    private static volatile String cleanedArtist;
+    /** The payload currently attached to the session, or null if none is. */
+    @Nullable
+    private static volatile String publishedJson;
+
+    private static final LyricsManager.Listener lyricsListener = (state, lyrics) -> {
+        latestLyrics = state == LyricsManager.State.LOADED ? lyrics : null;
+        schedulePublish();
+    };
+
+    private LyricInfoPublisher() {
+    }
+
+    /** Re-evaluates after the setting, or a lyrics setting that changes the timing, changed. */
+    public static void onSettingsChanged() {
+        publishedJsonInvalidate();
+        schedulePublish();
+    }
+
+    /**
+     * Observed in front of the app's {@code MediaSession.setMetadata}. The app is about to
+     * replace the metadata, which drops the lyric info, so it has to be published again.
+     */
+    public static void onMediaSessionSetMetadata(MediaSession session, MediaMetadata original) {
+        try {
+            if (session == null || original == null) {
+                return;
+            }
+            if (!isEnabled()) {
+                LyricsManager.getInstance().removeListener(lyricsListener);
+                publishedJson = null;
+                return;
+            }
+
+            sessionRef = new WeakReference<>(session);
+            originalMetadata = original;
+
+            String title = original.getString(MediaMetadata.METADATA_KEY_TITLE);
+            String artist = original.getString(MediaMetadata.METADATA_KEY_ARTIST);
+            String[] parsed = MetadataCleaner.parseCleanTitleAndArtist(title, artist);
+            cleanedTitle = parsed[1];
+            cleanedArtist = parsed[0];
+
+            // The app's call replaces whatever was attached.
+            publishedJson = null;
+
+            Uri mediaUri = LyricsManager.parseMediaUri(original);
+            LyricsManager manager = LyricsManager.getInstance();
+            manager.onDisplayedTrackChanged(title, artist, mediaUri);
+            // Delivers the current state to the listener right away, which schedules a publish.
+            manager.addListener(lyricsListener);
+            schedulePublish();
+        } catch (Exception ex) {
+            Logger.printException(() -> "onMediaSessionSetMetadata failure", ex);
+        }
+    }
+
+    private static boolean isEnabled() {
+        return Settings.LYRICS_ENABLED.get() && Settings.LYRICS_COLOROS.get();
+    }
+
+    private static void publishedJsonInvalidate() {
+        publishedJson = null;
+    }
+
+    private static void schedulePublish() {
+        handler.removeCallbacks(publishTask);
+        handler.postDelayed(publishTask, PUBLISH_DELAY_MS);
+    }
+
+    private static void publish() {
+        try {
+            WeakReference<MediaSession> reference = sessionRef;
+            MediaSession session = reference != null ? reference.get() : null;
+            MediaMetadata original = originalMetadata;
+            if (session == null || original == null) {
+                return;
+            }
+            if (!isEnabled()) {
+                restoreIfPublished(session, original);
+                return;
+            }
+
+            LyricsManager manager = LyricsManager.getInstance();
+            Lyrics lyrics = latestLyrics;
+            TrackInfo track = manager.getCurrentTrack();
+            // The lyrics must belong to the track the session is showing.
+            if (lyrics == null || !lyrics.synced() || lyrics.isEmpty() || track == null
+                    || !Objects.equals(track.title(), cleanedTitle)
+                    || !Objects.equals(track.artist(), cleanedArtist)) {
+                restoreIfPublished(session, original);
+                return;
+            }
+
+            String json = buildJson(lyrics, original, manager);
+            if (json == null) {
+                restoreIfPublished(session, original);
+                return;
+            }
+            if (json.equals(publishedJson)) {
+                return;
+            }
+
+            session.setMetadata(new MediaMetadata.Builder(original)
+                    .putString(LYRIC_INFO_KEY, json)
+                    .build());
+            publishedJson = json;
+        } catch (Exception ex) {
+            Logger.printException(() -> "publish failure", ex);
+        }
+    }
+
+    private static void restoreIfPublished(MediaSession session, MediaMetadata original) {
+        if (publishedJson == null) {
+            return;
+        }
+        session.setMetadata(original);
+        publishedJson = null;
+    }
+
+    @Nullable
+    private static String buildJson(Lyrics lyrics, MediaMetadata original, LyricsManager manager)
+            throws Exception {
+        // Lyric time -> the video timeline the PlaybackState position is on. This undoes what
+        // LyricsManager.getPositionMs() applies when it reads a lyric time.
+        final long offsetMs = Settings.LYRICS_OFFSET_MS.get() + manager.getTemporaryOffsetMs();
+
+        List<long[]> order = new ArrayList<>();
+        List<String> texts = new ArrayList<>();
+        for (LyricsLine line : lyrics.lines()) {
+            // Background vocals overlap the main line in time and would make the page flicker.
+            if (line.isBG() || line.startTimeMs() == LyricsLine.NO_TIME) {
+                continue;
+            }
+            long timeMs = Math.max(0L, manager.toVideoTimeMs(line.startTimeMs() + offsetMs));
+            order.add(new long[]{timeMs, texts.size()});
+            String text = line.text() == null ? "" : line.text();
+            texts.add(text.replace('\r', ' ').replace('\n', ' ').trim());
+        }
+        if (texts.isEmpty()) {
+            return null;
+        }
+        order.sort((a, b) -> Long.compare(a[0], b[0]));
+
+        StringBuilder lrc = new StringBuilder();
+        for (long[] entry : order) {
+            lrc.append(timestamp(entry[0])).append(texts.get((int) entry[1])).append('\n');
+        }
+        if (lrc.length() > MAX_LRC_CHARS) {
+            return null;
+        }
+
+        String title = original.getString(MediaMetadata.METADATA_KEY_TITLE);
+        String artist = original.getString(MediaMetadata.METADATA_KEY_ARTIST);
+        String mediaId = original.getString(MediaMetadata.METADATA_KEY_MEDIA_ID);
+        String songId = mediaId != null && !mediaId.isEmpty() ? mediaId : String.valueOf(title);
+        long durationSeconds = original.getLong(MediaMetadata.METADATA_KEY_DURATION) / 1000;
+
+        return new JSONObject()
+                .put("songName", title == null ? "" : title)
+                .put("artist", artist == null ? "" : artist)
+                .put("songId", songId)
+                .put("lyricType", 0)
+                .put("lyric", lrc.toString())
+                .put("noLyric", false)
+                .put("provider", PROVIDER)
+                .put("source", PROVIDER + "-lyrics")
+                .put("trackKey", songId + "|" + String.valueOf(title).toLowerCase(Locale.ROOT)
+                        + "|" + String.valueOf(artist).toLowerCase(Locale.ROOT)
+                        + "|" + durationSeconds)
+                .put("sessionGeneration", 1)
+                .toString();
+    }
+
+    private static String timestamp(long ms) {
+        return String.format(Locale.US, "[%02d:%02d.%03d]",
+                ms / 60_000, (ms / 1000) % 60, ms % 1000);
+    }
+}
